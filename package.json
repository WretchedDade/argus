{
    "name": "argus",
    "private": true,
    "version": "0.15.0",
    "type": "module",
    "imports": {
        "#shared/*": "./shared/*.ts"
    },
    "engines": {
        "node": ">=22.13"
    },
    "description": "Argus - PR triage canvas. React + TanStack, served by its own Node process.",
    "scripts": {
        "dev": "vite build --watch",
        "build:client": "vite build",
        "build:server": "esbuild server/extension.ts --bundle --platform=node --format=esm --outfile=extension.mjs --external:@github/copilot-sdk --external:@azure/identity --external:@azure/identity-broker --external:pino",
        "build": "npm run build:client && npm run build:server",
        "standalone": "node server/standalone.ts",
        "prepare": "husky",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "knip": "knip --include files,exports,types",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "lint-staged": {
        "!(*.ts|*.tsx)": "prettier --write --ignore-unknown",
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "dependencies": {
        "@azure/identity": "^4.14.0",
        "@azure/identity-broker": "^1.4.2",
        "@devstart/ado-client": "file:./packages/ado-client",
        "@hono/node-server": "^2.1.5",
        "@hono/zod-validator": "^0.9.1",
        "@mantine/charts": "9.8.0",
        "@mantine/core": "9.8.0",
        "@mantine/hooks": "9.8.0",
        "@tanstack/react-form": "^1.33.5",
        "@tanstack/react-query": "^5.62.0",
        "@tanstack/react-router": "^1.87.0",
        "cockatiel": "^4.0.0",
        "es-toolkit": "^1.52.0",
        "hono": "^4.13.14",
        "lucide-react": "^1.41.0",
        "pino": "^10.4.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-markdown": "^10.1.0",
        "recharts": "^3.10.1",
        "remark-gfm": "^4.0.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.0.0",
        "@tanstack/router-plugin": "^1.168.35",
        "@types/node": "^22.10.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^4.3.4",
        "@vitest/coverage-v8": "5.1.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.13.0",
        "eslint-plugin-boundaries": "^7.4.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "husky": "9.1.7",
        "knip": "^6.45.1",
        "lint-staged": "17.6.0",
        "prettier": "3.9.10",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.7.0",
        "typescript-eslint": "^8.72.1",
        "vite": "^6.0.0",
        "vitest": "5.1.0"
    },
    "knip": {
        "entry": [
            "src/routes/**/*.{ts,tsx}",
            "src/**/*.test.ts"
        ],
        "project": [
            "src/**/*.{ts,tsx,css}"
        ],
        "ignoreExportsUsedInFile": true
    }
}
