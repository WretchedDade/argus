{
    "name": "argus",
    "private": true,
    "version": "0.2.0",
    "type": "module",
    "description": "Argus - PR triage canvas. React + TanStack, served by its own Node process.",
    "scripts": {
        "dev": "vite build --watch",
        "build:client": "vite build",
        "build:server": "esbuild server/extension.ts --bundle --platform=node --format=esm --outfile=extension.mjs --external:@github/copilot-sdk --external:@azure/identity --external:@azure/identity-broker",
        "build": "npm run build:client && npm run build:server",
        "standalone": "node server/standalone.ts",
        "prepare": "husky && npm run build",
        "test": "node server/db.test.ts && node server/standalone.test.ts && node server/ado/reconcile.test.ts && node server/ado/normalize.test.ts && node src/lib/queue-filters.test.ts && node server/automatic-review.test.ts && node server/load-detail.test.ts && node server/weekly-review-facts.test.ts && node server/config.test.ts && node server/notices.test.ts && npm test --prefix packages/ado-client",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "lint-staged": {
        "*": "prettier --write --ignore-unknown"
    },
    "dependencies": {
        "@azure/identity": "^4.14.0",
        "@azure/identity-broker": "^1.4.2",
        "@devstart/ado-client": "file:./packages/ado-client",
        "@headlessui/react": "^2.2.10",
        "@tanstack/react-form": "^1.33.5",
        "@tanstack/react-query": "^5.62.0",
        "@tanstack/react-router": "^1.87.0",
        "es-toolkit": "^1.52.0",
        "lucide-react": "^1.41.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-markdown": "^10.1.0",
        "recharts": "^3.10.1",
        "rehype-raw": "^7.0.0",
        "remark-gfm": "^4.0.1"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@tanstack/router-plugin": "^1.168.35",
        "@types/node": "^22.10.0",
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.4",
        "esbuild": "^0.24.0",
        "husky": "9.1.7",
        "lint-staged": "17.6.0",
        "prettier": "3.9.10",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.7.0",
        "vite": "^6.0.0"
    }
}
