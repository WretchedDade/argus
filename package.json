{
    "name": "argus",
    "private": true,
    "version": "0.12.2",
    "type": "module",
    "imports": {
        "#shared/*": "./shared/*.ts"
    },
    "engines": {
        "node": ">=22.13"
    },
    "description": "Argus - PR triage canvas. React + TanStack, served by its own Node process.",
    "scripts": {
        "dev": "vite build --watch",
        "build:client": "vite build",
        "build:server": "esbuild server/extension.ts --bundle --platform=node --format=esm --outfile=extension.mjs --external:@github/copilot-sdk --external:@azure/identity --external:@azure/identity-broker",
        "build": "npm run build:client && npm run build:server",
        "standalone": "node server/standalone.ts",
        "prepare": "husky",
        "test": "node --test \"server/**/*.test.ts\" \"shared/**/*.test.ts\" \"src/**/*.test.ts\" \"scripts/**/*.test.ts\" && npm test --prefix packages/ado-client",
        "test:coverage": "node --test --experimental-test-coverage \"server/**/*.test.ts\" \"shared/**/*.test.ts\" \"src/**/*.test.ts\" \"scripts/**/*.test.ts\" && npm test --prefix packages/ado-client",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "lint-staged": {
        "!(*.ts|*.tsx)": "prettier --write --ignore-unknown",
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "dependencies": {
        "@azure/identity": "^4.14.0",
        "@azure/identity-broker": "^1.4.2",
        "@devstart/ado-client": "file:./packages/ado-client",
        "@headlessui/react": "^2.2.10",
        "@tanstack/react-form": "^1.33.5",
        "@tanstack/react-query": "^5.62.0",
        "@tanstack/react-router": "^1.87.0",
        "cockatiel": "^4.0.0",
        "es-toolkit": "^1.52.0",
        "lucide-react": "^1.41.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-markdown": "^10.1.0",
        "recharts": "^3.10.1",
        "remark-gfm": "^4.0.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.0.0",
        "@tanstack/router-plugin": "^1.168.35",
        "@types/node": "^22.10.0",
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.4",
        "esbuild": "^0.28.2",
        "eslint": "^10.13.0",
        "eslint-plugin-boundaries": "^7.4.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "husky": "9.1.7",
        "lint-staged": "17.6.0",
        "prettier": "3.9.10",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.7.0",
        "typescript-eslint": "^8.72.1",
        "vite": "^6.0.0"
    }
}
